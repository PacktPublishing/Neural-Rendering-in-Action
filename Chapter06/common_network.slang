//
// Shared building blocks for every *_train.slang module in this chapter
// (Sections 4-6's SlangPy ports): one differentiable dense layer's
// parameters, and the Adam optimizer step that updates them. Both are
// byte-identical across every section that used to define them locally --
// see git history if you want the single-file, fully self-contained version
// each port originally shipped as.
//
// Each section's own *_train.slang file still defines everything that
// actually varies from section to section: the network's Network struct
// (how many layers, what the positional encoding looks like, the loss),
// and its own entry points (calculate_grads, predict_batch, ...). Only the
// two primitives below -- used unchanged everywhere -- live here.

import slangpy;

public struct NetworkParameters<int Inputs, int Outputs>
{
    Tensor<float, 1> biases;
    Tensor<float, 2> weights;
    AtomicTensor<float, 1> biases_grad;
    AtomicTensor<float, 2> weights_grad;

    // y = W x + b. The backward pass is written by hand (forward_bwd) rather
    // than generated by Slang, for two reasons:
    //  - Correctness: Slang's generated backward through these two nested
    //    [MaxIters] loops returns a wrong dL/dx whenever Inputs and Outputs
    //    differ by more than 2 (seen on Slang 2025.21 through 2026.12), which
    //    silently corrupts every layer upstream of such a layer.
    //  - Cost: the generated backward stores per-iteration loop state, so
    //    per-thread memory grows as Inputs * Outputs; past hidden ~24 the
    //    driver's shader compiler rejects the kernel. [ForceUnroll] avoids
    //    both problems but compiles for minutes even at hidden 32.
    // The hand-written version needs only x, W and dy.
    [BackwardDerivative(forward_bwd)]
    public float[Outputs] forward(float[Inputs] x)
    {
        float[Outputs] y;
        for (int row = 0; row < Outputs; ++row)
        {
            float sum = biases.load(row);
            for (int col = 0; col < Inputs; ++col)
                sum += weights.load(row, col) * x[col];
            y[row] = sum;
        }
        return y;
    }

    // dW += dy x^T,  db += dy,  dx = W^T dy.
    void forward_bwd(inout DifferentialPair<float[Inputs]> x, float[Outputs] dy)
    {
        float[Inputs] dx;
        for (int col = 0; col < Inputs; ++col)
            dx[col] = 0.0f;
        for (int row = 0; row < Outputs; ++row)
        {
            float g = dy[row];
            biases_grad.add(row, g);
            for (int col = 0; col < Inputs; ++col)
            {
                weights_grad.add(row, col, g * x.p[col]);
                dx[col] += weights.load(row, col) * g;
            }
        }
        x = diffPair(x.p, dx);
    }
}

// Adam, identical everywhere in this chapter it's used.
public void optimizer_step(inout float primal, inout float grad, inout float mean,
                           inout float variance, float learning_rate, int iteration)
{
    const float ADAM_BETA_1 = 0.9;
    const float ADAM_BETA_2 = 0.999;
    const float ADAM_EPSILON = 1e-8;

    mean = lerp(grad, mean, ADAM_BETA_1);
    variance = lerp(grad * grad, variance, ADAM_BETA_2);

    float mHat = mean / (1.0f - pow(ADAM_BETA_1, iteration));
    float vHat = variance / (1.0f - pow(ADAM_BETA_2, iteration));
    float step = learning_rate * mHat / (sqrt(vHat) + ADAM_EPSILON);

    primal -= step;
    grad = 0.0f;
}
